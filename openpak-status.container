[Unit]
Description=OpenPak status page (Gatus)
After=network-online.target

[Container]
ContainerName=openpak-status
# ghcr, not Docker Hub: this host cannot reach registry-1.docker.io at all
# (i/o timeout), while ghcr and quay answer normally.
Image=ghcr.io/twin/gatus:latest
AutoUpdate=registry
# Localhost only, and NOT the port the tunnel points at: this is the checker,
# and only the branded page (8450) is meant to be reachable from outside.
PublishPort=127.0.0.1:8460:8080
Volume=%h/openpak-status/gatus.yaml:/config/config.yaml:ro,Z
Volume=openpak-status-data:/data
# The console-facing names resolve to Nintendo for everyone else. A console
# reaches us because its own DNS is redirected; these do the same thing for the
# prober, so the checks follow the console's path rather than the public one.
# PodmanArgs rather than AddHost=: the deploy host runs podman 4.9, where that
# quadlet key does not exist yet.
PodmanArgs=--add-host=player-auth.services.api.unity.com:145.241.199.19 --add-host=lobby.services.api.unity.com:145.241.199.19 --add-host=dauth-lp1.ndas.srv.nintendo.net:145.241.199.19 --add-host=e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com:145.241.199.19 --add-host=accounts.nintendo.com:145.241.199.19 --add-host=dragons.hac.lp1.dragons.nintendo.net:145.241.199.19 --add-host=cdn-image-e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com:145.241.199.19 --add-host=ranking-view.np.community.playstation.net:145.241.199.19 --add-host=static-resource.np.community.playstation.net:145.241.199.19 --add-host=nsx.sec.np.dl.playstation.net:145.241.199.19 --add-host=auth.np.ac.playstation.net:145.241.199.19 --add-host=getprof.us.np.community.playstation.net:145.241.199.19 --add-host=a0.ww.np.dl.playstation.net:145.241.199.19 --add-host=uploader.np.community.playstation.net:145.241.199.19 --add-host=dus01.ps4.update.playstation.net:145.241.199.19 --add-host=5ea1.playfabapi.com:145.241.199.19 --add-host=account.battle.net:145.241.199.19 --add-host=api-lp1.pctl.srv.nintendo.net:145.241.199.19 --add-host=api.epicgames.dev:145.241.199.19 --add-host=api.minecraftservices.com:145.241.199.19 --add-host=api.stumbleguys.com:145.241.199.19 --add-host=atum.hac.lp1.d4c.nintendo.net:145.241.199.19 --add-host=backend.innersloth.com:145.241.199.19 --add-host=bcat-list-lp1.cdn.nintendo.net:145.241.199.19 --add-host=directory.t17service.com:145.241.199.19 --add-host=fro-3.hac.lp1.penne.srv.nintendo.net:145.241.199.19 --add-host=geo.battle.net:145.241.199.19 --add-host=hac.lp1.savanna.srv.nintendo.net:145.241.199.19 --add-host=lobby-v2.klei.com:145.241.199.19 --add-host=login.fallguys.oncatapult.com:145.241.199.19 --add-host=login.kleientertainment.com:145.241.199.19 --add-host=matchmaker.among.us:145.241.199.19 --add-host=ns.photonengine.io:145.241.199.19 --add-host=prod.umbrella.demonware.net:145.241.199.19 --add-host=profile.xboxlive.com:145.241.199.19 --add-host=unrailed-online.com:145.241.199.19 --add-host=web-lp1.share.srv.nintendo.net:145.241.199.19

[Service]
Restart=always

[Install]
WantedBy=default.target
